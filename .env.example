# Public Clerk key: this value is bundled into browser code.
VITE_CLERK_PUBLISHABLE_KEY=

# Server-only secrets: never add the VITE_ prefix.
CLERK_SECRET_KEY=
# Runtime connection must use the SQL-created torque_app_runtime_restricted role.
# npm run db:migrate provisions it and writes the local URL after migration 0005.
DATABASE_URL=
# Administrative direct Neon connection for neondb_owner, required only by migration/bootstrap scripts.
# Never use DATABASE_URL as a fallback or add this value to Vercel.
DATABASE_ADMIN_URL=
SUPABASE_STORAGE_ENDPOINT=https://rpxjfhbcmfujeizbzrbe.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=sa-east-1
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=work-order-photos
